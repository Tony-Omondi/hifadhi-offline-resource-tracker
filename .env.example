# Copy to .env for local runs; set the same keys in the PrimeCloud dashboard.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.primecloud.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.primecloud.example
DJANGO_SECURE_SSL_REDIRECT=0
# Optional: DATABASE_URL=postgres://user:pass@host:5432/db  (defaults to SQLite)
APP_VERSION=0.1.0
